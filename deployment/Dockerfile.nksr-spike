# Experimental ARM64/GB10 build. Not a qualified production runtime.
# Reuses an image already present on Spark; do not pull large images locally.
FROM nvcr.io/nvidia/vllm@sha256:6e537fc8d84beb9b60e789236168141d2ef4420bc28cbb85ec7d4318ca918b6c
ENV NKSR_COMMIT=e40336845e67761343a756788e5a98b827d4a143 \
    TORCH_CUDA_ARCH_LIST=12.1 MAX_JOBS=2 TORCH_HOME=/weights
WORKDIR /opt/NKSR
COPY NKSR/ /opt/NKSR/
RUN test "$(git rev-parse HEAD)" = "$NKSR_COMMIT"
# Upstream dependency ranges are intentional for this compatibility spike.
# Freeze the resolved environment and dependency commits before promotion (H42).
RUN python -m pip install --no-cache-dir ninja GitPython python-pycg pykdtree omegaconf
RUN python -m pip install --no-cache-dir --no-build-isolation --no-deps ./package
COPY nksr_smoke.py /opt/nksr_smoke.py
ENTRYPOINT ["python", "/opt/nksr_smoke.py"]
