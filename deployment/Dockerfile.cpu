FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 libidn2-0 libgfortran5 libegl1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.8.14
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
COPY lidar2sim ./lidar2sim
COPY configs/baseline.yaml configs/poc-detailed.yaml configs/poc-high-detail.yaml ./configs/
COPY configs/acceptance ./configs/acceptance
COPY tools ./tools
RUN uv sync --locked --no-dev --python /usr/local/bin/python
ENV PATH="/app/.venv/bin:$PATH" OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
USER 65534:65534
ENTRYPOINT ["python"]
