  "supported_scope": ["static_single_level_indoor"],
  "quality_envelope": {
    "status": "uncalibrated",
    "density_range": null,
    "noise_range_m": null,
    "minimum_observed_fraction": null,
    "required_evidence": ["H35 independent real scenes", "H41 held-out qualification"]
  },
  "quality_states": ["not_verified", "accepted", "failed", "needs_rescan"],
  "acceptance_requires": ["versioned calibrated scope", "independent geometry evidence", "scene-specific physics and robot", "matching artifact hashes"],
  "legacy_profile": "lidar2sim-rules-v2; qualified only on recorded A/C runs"
}
